PORT=8787
DATA_DIR=./data

# --- Accesso ----------------------------------------------------------------
# Protegge TUTTO — esperienza, contenuti e API — con una password.
# Lasciare vuoto in sviluppo e in sala: serve solo per l'anteprima pubblica.
# Richiede HTTPS: l'autenticazione di base non cifra la password.
APP_USER=kandinsky
APP_PASSWORD=

# Percorsi dei file statici. I default vanno bene: si impostano solo se
# l'esperienza compilata viene messa altrove.
# KIOSK_DIR=
# CONTENT_DIR=

# --- SMTP -------------------------------------------------------------------
# Regola che fa perdere più tempo di ogni altra:
#   porta 465 -> SMTP_SECURE=true   (TLS implicito)
#   porta 587 -> SMTP_SECURE=false  (STARTTLS)
# La combinazione sbagliata dà un timeout senza messaggio d'errore utile.
#
# Provider italiani più comuni:
#   Aruba      smtps.aruba.it        465  secure=true
#   Register   authsmtp.securemail.pro 465 secure=true
#   Gmail      smtp.gmail.com        587  secure=false  (serve una password per le app)
#   Office 365 smtp.office365.com    587  secure=false
#
# Molti provider rifiutano l'invio se MAIL_FROM non coincide con SMTP_USER.
# Meglio una casella dedicata: se il chiosco satura il rate limit, non deve
# bloccare la posta istituzionale del museo.
SMTP_HOST=smtps.aruba.it
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=kandinskylab@museo.it
SMTP_PASS=

MAIL_FROM="Kandinsky Lab <kandinskylab@museo.it>"
MUSEUM_NAME="Nome del Museo"
MUSEUM_URL="https://www.museo.it"

# Base URL della pagina di riascolto linkata nell'e-mail.
# Lasciare vuoto per spedire solo l'immagine, senza link alla musica.
LISTEN_BASE_URL=

# Retention: minuti dopo l'invio prima di cancellare l'indirizzo e-mail
PURGE_EMAIL_AFTER_MIN=60
# Giorni prima di cancellare i PNG archiviati
PURGE_IMAGES_AFTER_DAYS=30
