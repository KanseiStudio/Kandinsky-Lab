{
  "name": "@kandinsky/shell",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "pack:win": "electron-builder --win --x64",
    "pack:mac": "electron-builder --mac --arm64 --x64",
    "pack:dir": "electron-builder --dir",
    "pack:win:locale": "electron-builder --win --x64 --config.electronDist=%ELECTRON_OVERRIDE_DIST_PATH%"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "it.kanseistudio.kandinskylab",
    "productName": "Kandinsky Lab",
    "copyright": "\u00a9 Kansei Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../kiosk/dist",
        "to": "kiosk"
      },
      {
        "from": "../../packages/content",
        "to": "content"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kandinsky-Lab-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kandinsky Lab"
    },
    "mac": {
      "category": "public.app-category.education",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Education"
    }
  }
}
