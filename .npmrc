shamefully-hoist=false
strict-peer-dependencies=false

# Cache degli effetti collaterali disattivata.
#
# pnpm memorizza il RISULTATO degli script postinstall e lo riusa: se una volta
# lo script è fallito o è stato saltato, ogni installazione successiva ripristina
# quello stato incompleto in poche centinaia di millisecondi, cancellare
# node_modules non serve a nulla e sembra che pnpm ignori i comandi.
#
# Con Electron, che nel postinstall scarica un binario da 250 MB, questa cache
# trasforma un errore temporaneo in un guasto permanente e incomprensibile.
side-effects-cache=false
