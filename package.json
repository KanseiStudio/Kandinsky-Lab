{
  "name": "kandinsky-lab",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:kiosk": "pnpm --filter @kandinsky/kiosk dev",
    "dev:server": "pnpm --filter @kandinsky/server dev",
    "build": "pnpm --filter @kandinsky/kiosk build && pnpm --filter @kandinsky/server build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @kandinsky/server start",
    "app:mac": "pnpm --filter @kandinsky/kiosk build && pnpm --filter @kandinsky/shell pack:mac",
    "app:win": "pnpm --filter @kandinsky/kiosk build && pnpm --filter @kandinsky/shell pack:win",
    "app:dev": "pnpm --filter @kandinsky/kiosk build && pnpm --filter @kandinsky/shell start"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=24"
  }
}
